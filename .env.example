# Copy this file to .env and adjust the values before running `docker compose up -d`

# ── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=chexspark
MINIO_ROOT_PASSWORD=chexspark123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=chexspark123
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ── Spark ───────────────────────────────────────────────────────────────────
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER1_UI_PORT=8081
SPARK_WORKER2_UI_PORT=8082
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=4G

# ── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_PORT=5000

# ── Airflow ─────────────────────────────────────────────────────────────────
# UI: http://localhost:8085 (admin / admin — chỉ dùng cho dev)
AIRFLOW_PORT=8085

# ── Serving (FastAPI + Streamlit) ───────────────────────────────────────────
# API:   http://localhost:8000/docs   ·  Dashboard: http://localhost:8501
SERVING_PORT=8000
STREAMLIT_PORT=8501
# 1 = nạp model từ MLflow registry (models:/…@production), 0 = load .pth local
SERVING_USE_REGISTRY=1
